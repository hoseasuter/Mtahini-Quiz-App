import tkinter as tk
from tkinter import messagebox
import json
import os


class Quiz:
    def __init__(self, root):
        self.root = root
        self.root.title("MTAHINI QUIZ APP")
        self.root.geometry("700x500")
        self.root.resizable(False, False)
        self.root.configure(bg="#2C3E50")

        # --- Quiz state variables ---
        self.score = 0
        self.current_question_index = 0
        self.total_questions = 0
        self.quiz_data = []

        # --- Load quiz data from JSON ---
        self.load_quiz_data()

        # --- Build the GUI ---
        self.setup_gui()

        # --- Display the first question ---
        self.display_question()

    def load_quiz_data(self):
        """Load questions, options, and answers from the JSON file."""
        # Try the same directory as the script first, then the current working directory
        script_dir = os.path.dirname(os.path.abspath(__file__))
        possible_paths = [
            os.path.join(script_dir, "quiz_data.json"),
            os.path.join(os.getcwd(), "quiz_data.json"),
        ]

        json_path = None
        for path in possible_paths:
            if os.path.exists(path):
                json_path = path
                break

        if json_path is None:
            messagebox.showerror(
                "Error",
                "quiz_data.json not found!\n"
                "Searched in:\n"
                f"  1. {possible_paths[0]}\n"
                f"  2. {possible_paths[1]}"
            )
            self.root.destroy()
            return

        try:
            with open(json_path, "r") as file:
                data = json.load(file)
                self.quiz_data = data["quiz"]
                self.total_questions = len(self.quiz_data)
        except json.JSONDecodeError:
            messagebox.showerror("Error", "Invalid JSON format in quiz_data.json!")
            self.root.destroy()

    def setup_gui(self):
        """Create and arrange all GUI elements."""
        # --- Title Label ---
        self.title_label = tk.Label(
            self.root,
            text="MTAHINI QUIZ APP",
            font=("Helvetica", 22, "bold"),
            bg="#2C3E50",
            fg="#ECF0F1",
            pady=15
        )
        self.title_label.pack(fill=tk.X)

        # --- Question Number Label ---
        self.question_number_label = tk.Label(
            self.root,
            text="",
            font=("Helvetica", 13),
            bg="#2C3E50",
            fg="#BDC3C7",
            anchor="w",
            padx=40
        )
        self.question_number_label.pack(fill=tk.X)

        # --- Question Text Label ---
        self.question_label = tk.Label(
            self.root,
            text="",
            font=("Helvetica", 16),
            bg="#2C3E50",
            fg="#FFFFFF",
            wraplength=600,
            justify="center",
            pady=20
        )
        self.question_label.pack(fill=tk.X)

        # --- Options Frame ---
        self.options_frame = tk.Frame(self.root, bg="#2C3E50")
        self.options_frame.pack(pady=10, padx=40, fill=tk.BOTH, expand=True)

        self.option_buttons = []
        self.selected_option = tk.StringVar()

        # --- Score Label ---
        self.score_label = tk.Label(
            self.root,
            text="Score: 0",
            font=("Helvetica", 12, "bold"),
            bg="#2C3E50",
            fg="#2ECC71",
            anchor="e",
            padx=40
        )
        self.score_label.pack(fill=tk.X, pady=(0, 15))

    def display_question(self):
        """Display the current question and its options on the GUI."""
        # Clear previous option buttons
        for button in self.option_buttons:
            button.destroy()
        self.option_buttons.clear()
        self.selected_option.set(None)

        if self.current_question_index >= self.total_questions:
            # Quiz is finished (handled in future steps)
            return

        # Get current question data
        question_data = self.quiz_data[self.current_question_index]
        question_text = question_data["question"]
        options = question_data["options"]

        # Update question number label
        self.question_number_label.config(
            text=f"Question {self.current_question_index + 1} of {self.total_questions}"
        )

        # Update question text
        self.question_label.config(text=question_text)

        # Create option radio buttons
        for i, option in enumerate(options):
            option_letter = chr(65 + i)  # A, B, C, D ...
            btn = tk.Radiobutton(
                self.options_frame,
                text=f"{option_letter}. {option}",
                variable=self.selected_option,
                value=option,
                font=("Helvetica", 13),
                bg="#34495E",
                fg="#ECF0F1",
                selectcolor="#1ABC9C",
                activebackground="#34495E",
                activeforeground="#ECF0F1",
                indicatoron=True,
                anchor="w",
                padx=20,
                pady=8
            )
            btn.pack(fill=tk.X, pady=4)
            self.option_buttons.append(btn)


# --- Run the Application ---
if __name__ == "__main__":
    root = tk.Tk()
    quiz = Quiz(root)
    root.mainloop()